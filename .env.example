# ── Fertilizer Dose — environment variables ──
# Copy to .env (local) or set in Vercel → Project → Settings → Environment Variables.

# Public site URL (used for canonicals / metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database (PostgreSQL) ──
# Without this, the app runs fully on the built-in static datasets and
# browser localStorage. With it, the CMS/admin, accounts and cloud garden
# sync activate. Get one free from Neon (neon.tech) or Vercel Postgres.
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# ── Auth.js ──
# Generate with: npx auth secret   (or: openssl rand -base64 32)
# Required for login/signup. Without it, auth routes will error.
AUTH_SECRET=
# AUTH_URL=  # only needed if the app is behind a proxy with a wrong host

# ── Gemini Plant Doctor (SERVER ONLY — never use a NEXT_PUBLIC_ prefix) ──
# Get a key at https://aistudio.google.com/apikey
# Without it, /api/plant-doctor/diagnose returns 501 with a clear message.
GEMINI_API_KEY=
# Optional: override the model (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# ── First admin ──
# The very first account created via /signup automatically becomes ADMIN.
# After that, manage roles at /admin/users.
