// Prisma schema — Fertilizer Dose backend.
// Covers: Auth.js models, CMS (fertilizers, growing library, regions,
// planting windows, sources, blog, FAQs, settings), My Garden (plots,
// plantings, calculations, reminders), Plant Doctor diagnoses.
//
// The frontend reads through src/server/data.ts, which falls back to the
// static TS datasets when DATABASE_URL is unset (so builds and local dev
// work without a database).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  EDITOR
  ADMIN
}

enum VerificationStatus {
  draft
  under_review
  verified
  published
  archived
  // NOTE: the underlying Postgres enum may still contain the legacy value
  // 'in_review' (Postgres cannot drop enum values). All rows were migrated
  // to 'under_review'; application code must use the five values above.
}

// ── Auth.js ──────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  plots         GardenPlot[]
  calculations  SavedCalculation[]
  reminders     GardenReminder[]
  diagnoses     Diagnosis[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── CMS: fertilizers ─────────────────────────────────────

model Fertilizer {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  urdu        String?
  // Single label values. Nullable: organics with ranges have NO single
  // honest value — a midpoint would be fake precision. Mineral rows keep
  // their label values; this column change is additive and lossless.
  n           Float?
  p           Float?
  k           Float?
  tagline     String?
  description String   @db.Text
  benefits    String[]
  precautions String[]
  application String   @db.Text
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ── Organic fertilizer support (Phase 2; additive, all nullable/defaulted) ──
  // fertilizerType: "mineral" | "organic"
  fertilizerType String @default("mineral")
  // organicCategory: "manure" | "compost" | "green_manure" (organics only)
  organicCategory String?
  // nutrientValueType: "fixed" | "typical_range" | "variable" | "lab_analysis_required"
  nutrientValueType String @default("fixed")
  // Honest variability caveat, shown in the UI wherever ranges appear.
  nutrientNote String? @db.Text
  // Typical-range bounds (percent). Null when not applicable. Midpoints are
  // NEVER stored here as single values (see n/p/k above).
  nMin Float?
  nMax Float?
  pMin Float?
  pMax Float?
  kMin Float?
  kMax Float?
  // Source for the typical ranges (URL).
  sourceUrl String?

  sources FertilizerSource[]
}

// ── CMS: growing library (crops, plants, vegetables) ────

model GrowingItem {
  id                String             @id @default(cuid())
  slug              String             @unique
  name              String
  urdu              String?
  scientificName    String?
  category          String // crop | vegetable | fruit | herb | flower | garden_plant | indoor_plant | outdoor_plant | plant (legacy)
  plantSubcategory  String?
  season            String?
  seasonDetail      String?            @db.Text
  sowingMonths      String?
  harvestPeriod     String?
  soil              String?            @db.Text
  water             String?            @db.Text
  sunlight          String?
  climate           String?            @db.Text
  regions           String[]
  npkN              Float?
  npkP              Float?
  npkK              Float?
  npkSource         String?
  verificationStatus VerificationStatus @default(under_review)
  indexable         Boolean            @default(false)
  published         Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  stages          GrowthStage[]
  sources         GrowingSource[]
  windows         PlantingWindow[]
  translations    GrowingItemTranslation[]
  recommendations FertilizerRecommendation[]
}

model GrowthStage {
  id          String      @id @default(cuid())
  itemId      String
  name        String
  timing      String?
  note        String?     @db.Text
  position    Int         @default(0)

  item GrowingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, position])
}

// ── CMS: countries + regions + planting windows ──────────

model Country {
  id          String   @id @default(cuid())
  code        String   @unique // ISO-ish: PK, IN, BD…
  name        String // Pakistan
  slug        String   @unique // pakistan
  defaultUnit String   @default("acre")
  status      String   @default("active") // active | inactive
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  regions         Region[]
  seasons         Season[]
  recommendations FertilizerRecommendation[]
}

model Region {
  id        String  @id @default(cuid())
  slug      String  @unique // e.g. pk-punjab
  country   String // pakistan | india (legacy string; prefer countryId)
  countryId String?
  name      String

  countryObj      Country?                  @relation(fields: [countryId], references: [id], onDelete: SetNull)
  windows         PlantingWindow[]
  plots           GardenPlot[]
  seasons         Season[]
  recommendations FertilizerRecommendation[]

  @@index([countryId])
}

model PlantingWindow {
  id                 String             @id @default(cuid())
  itemId             String
  regionId           String
  // SOW | TRANSPLANT | PLANT | HARVEST | LAND_PREPARATION
  activityType       String             @default("SOW")
  seasonId           String?
  startMonth         Int
  endMonth           Int
  harvestText        String?
  notes              String?            @db.Text
  verificationStatus VerificationStatus @default(under_review)
  lastReviewed       DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  item    GrowingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  region  Region      @relation(fields: [regionId], references: [id], onDelete: Cascade)
  season  Season?     @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  sources WindowSource[]

  @@index([regionId, startMonth])
  @@index([regionId, activityType])
}

// ── CMS: seasons (country/region agro-climatic seasons) ──

model Season {
  id          String   @id @default(cuid())
  countryId   String
  regionId    String? // null = country-wide season
  name        String // Rabi | Kharif | Spring …
  startMonth  Int
  endMonth    Int
  description String?  @db.Text
  sourceId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)
  region  Region? @relation(fields: [regionId], references: [id], onDelete: SetNull)
  source  Source? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  windows PlantingWindow[]

  @@index([countryId, regionId])
}

// ── CMS: per-locale presentation of growing items ────────
// Agronomic facts stay on GrowingItem (shared); only presentation
// (names/descriptions) is translated. Never duplicate facts per locale.

model GrowingItemTranslation {
  id            String   @id @default(cuid())
  growingItemId String
  locale        String // hi | ar | es …
  name          String
  localName     String?
  description   String?  @db.Text
  growingNotes  String?  @db.Text
  status        String   @default("draft") // draft | machine_translated | review_required | reviewed | published
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  item GrowingItem @relation(fields: [growingItemId], references: [id], onDelete: Cascade)

  @@unique([growingItemId, locale])
  @@index([locale])
}

// ── CMS: fertilizer recommendations (highest-risk data) ──
// One row = one verified recommendation with explicit applicability.
// NEVER infer a recommendation for a country/region it wasn't sourced for.
// Nutrient basis is explicit: n is elemental N (kg/ha); p2o5/k2o are oxide
// basis (kg/ha). Never silently mix elemental P/K with P2O5/K2O.

model FertilizerRecommendation {
  id                 String             @id @default(cuid())
  growingItemId      String
  countryId          String
  regionId           String? // null = country-wide applicability
  variety            String?
  soilContext        String?            @db.Text
  irrigationContext  String?
  growthStage        String?
  n                  Float? // kg N / ha (elemental)
  p2o5               Float? // kg P2O5 / ha (oxide basis)
  k2o                Float? // kg K2O / ha (oxide basis)
  nutrientBasis      String             @default("P2O5_K2O")
  micronutrients     String?            @db.Text
  applicationTiming  String?            @db.Text
  applicationMethod  String?            @db.Text
  sourceId           String
  verificationStatus VerificationStatus @default(draft)
  isPrimary          Boolean            @default(false) // calculator shows this record for its crop x country when set
  lastReviewed       DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  item    GrowingItem @relation(fields: [growingItemId], references: [id], onDelete: Cascade)
  country Country     @relation(fields: [countryId], references: [id], onDelete: Cascade)
  region  Region?     @relation(fields: [regionId], references: [id], onDelete: SetNull)
  source  Source      @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([countryId, regionId])
  @@index([growingItemId, countryId])
}

// ── CMS: sources ─────────────────────────────────────────

model Source {
  id                 String             @id @default(cuid())
  organization       String
  title              String
  url                String?
  country            String?
  region             String?
  publishedAt        DateTime?
  lastReviewed       DateTime?
  // government | university | extension | research | international | peer_reviewed | other
  sourceType         String?
  verificationStatus VerificationStatus @default(under_review)
  notes              String?            @db.Text
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  fertilizers     FertilizerSource[]
  growing         GrowingSource[]
  windows         WindowSource[]
  seasons         Season[]
  recommendations FertilizerRecommendation[]
}

model FertilizerSource {
  fertilizerId String
  sourceId     String

  fertilizer Fertilizer @relation(fields: [fertilizerId], references: [id], onDelete: Cascade)
  source     Source     @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([fertilizerId, sourceId])
}

model GrowingSource {
  itemId   String
  sourceId String

  item   GrowingItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  source Source      @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([itemId, sourceId])
}

model WindowSource {
  windowId String
  sourceId String

  window PlantingWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)
  source Source         @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([windowId, sourceId])
}

// ── CMS: blog + FAQ + settings ───────────────────────────

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String    @db.Text
  body        String    @db.Text
  category    String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question  String   @db.Text
  answer    String   @db.Text
  position  Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// ── My Garden (per-user; localStorage remains the offline fallback) ──

model GardenPlot {
  id       String  @id @default(cuid())
  userId   String
  name     String
  location String?
  regionId String?
  area     Float
  unit     String // acre | kanal | marla | hectare
  soilType String?
  notes    String? @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  region    Region?    @relation(fields: [regionId], references: [id], onDelete: SetNull)
  plantings Planting[]
  reminders GardenReminder[]

  @@index([userId])
}

model Planting {
  id        String   @id @default(cuid())
  plotId    String
  itemSlug  String
  plantedOn DateTime @db.Date
  stage     String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plot      GardenPlot       @relation(fields: [plotId], references: [id], onDelete: Cascade)
  reminders GardenReminder[]

  @@index([plotId])
}

model SavedCalculation {
  id        String   @id @default(cuid())
  userId    String
  cropSlug  String
  area      Float
  unit      String
  products  Json // [{ product, kg }]
  notes     String?  @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GardenReminder {
  id         String    @id @default(cuid())
  userId     String
  title      String
  dueDate    DateTime  @db.Date
  plotId     String?
  plantingId String?
  done       Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plot     GardenPlot? @relation(fields: [plotId], references: [id], onDelete: Cascade)
  planting Planting?   @relation(fields: [plantingId], references: [id], onDelete: Cascade)

  @@index([userId, dueDate])
}

// ── Plant Doctor diagnoses ───────────────────────────────

model Diagnosis {
  id         String   @id @default(cuid())
  userId     String?
  imageUrl   String?
  symptoms   String   @db.Text
  cropHint   String?
  result     Json
  confidence String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}
